+/* Save the monitor's layout state into the current tag's slot */
+void
+pertagsave(Monitor *m)
+{
+	Pertag *pt = m->pertag;
+
+	pt->nmasters[pt->curtag] = m->nmaster;
+	pt->mfacts[pt->curtag] = m->mfact;
+	pt->sellts[pt->curtag] = m->sellt;
+	pt->ltidxs[pt->curtag][m->sellt] = m->lt[m->sellt];
+}
+
+/* After a tagset change: pick the matching tag slot and load its state */
+void
+pertagsync(Monitor *m)
+{
+	Pertag *pt = m->pertag;
+	uint32_t ts = m->tagset[m->seltags] & TAGMASK;
+	unsigned int i;
+
+	if (ts == TAGMASK) {
+		pt->curtag = 0;
+	} else if (pt->curtag == 0 || !(ts & (1u << (pt->curtag - 1)))) {
+		for (i = 0; i < TAGCOUNT && !(ts & (1u << i)); i++);
+		pt->curtag = i + 1;
+	}
+	m->nmaster = pt->nmasters[pt->curtag];
+	m->mfact = pt->mfacts[pt->curtag];
+	m->sellt = pt->sellts[pt->curtag];
+	m->lt[m->sellt] = pt->ltidxs[pt->curtag][m->sellt];
+	m->lt[m->sellt ^ 1] = pt->ltidxs[pt->curtag][m->sellt ^ 1];
+	strncpy(m->ltsymbol, m->lt[m->sellt]->symbol, LENGTH(m->ltsymbol));
+}

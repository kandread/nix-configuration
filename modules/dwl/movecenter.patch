 void
+movecenter(const Arg *arg)
+{
+	Client *c = focustop(selmon);
+	struct wlr_box b;
+
+	if (!c || !c->mon || !c->isfloating)
+		return;
+
+	b = c->mon->w;
+	resize(c, (struct wlr_box){
+		.x = (b.width - c->geom.width) / 2 + b.x,
+		.y = (b.height - c->geom.height) / 2 + b.y,
+		.width = c->geom.width,
+		.height = c->geom.height,
+	}, 1);
+}

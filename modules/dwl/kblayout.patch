+void
+kblayout(KeyboardGroup *group)
+{
+	/* Write the active layout's name to $XDG_RUNTIME_DIR/dwl-kblayout
+	 * whenever it changes, for the bar. Layout switches arrive as
+	 * modifiers events. */
+	static xkb_layout_index_t last = XKB_LAYOUT_INVALID;
+	struct wlr_keyboard *kb = &group->wlr_group->keyboard;
+	xkb_layout_index_t layout;
+	const char *dir, *name;
+	char path[PATH_MAX];
+	FILE *f;
+
+	if (group != kb_group || !kb->xkb_state
+			|| !(dir = getenv("XDG_RUNTIME_DIR")))
+		return;
+	layout = xkb_state_serialize_layout(kb->xkb_state, XKB_STATE_LAYOUT_EFFECTIVE);
+	if (layout == last)
+		return;
+	last = layout;
+	name = xkb_keymap_layout_get_name(kb->keymap, layout);
+	snprintf(path, sizeof(path), "%s/dwl-kblayout", dir);
+	if ((f = fopen(path, "w"))) {
+		fprintf(f, "%s\n", name ? name : "?");
+		fclose(f);
+	}
+}

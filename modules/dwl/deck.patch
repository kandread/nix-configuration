 void
+deck(Monitor *m)
+{
+	unsigned int my, slot;
+	int i, n = 0, ax, ay, aw, ah, mw, g = gappx;
+	Client *c, *top = NULL, *foc;
+
+	wl_list_for_each(c, &clients, link)
+		if (VISIBLEON(c, m) && !c->isfloating && !c->isfullscreen)
+			n++;
+	if (n == 0)
+		return;
+
+	/* usable area, inset by the outer gap */
+	ax = m->w.x + g;
+	ay = m->w.y + g;
+	aw = m->w.width - 2 * g;
+	ah = m->w.height - 2 * g;
+
+	if (n > m->nmaster)
+		mw = m->nmaster ? (int)roundf(aw * m->mfact) : 0;
+	else
+		mw = aw;
+	i = my = 0;
+	foc = focustop(m);
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+			continue;
+		if (i < m->nmaster) {
+			slot = (ah + g - my) / (MIN(n, m->nmaster) - i);
+			resize(c, (struct wlr_box){.x = ax, .y = ay + my,
+				.width = (n > m->nmaster) ? mw - g / 2 : mw,
+				.height = slot - g}, 0);
+			my += slot;
+		} else {
+			/* every stacked client shares one box; one is raised */
+			resize(c, (struct wlr_box){.x = ax + mw + (m->nmaster ? g / 2 : 0), .y = ay,
+				.width = aw - mw - (m->nmaster ? g / 2 : 0), .height = ah}, 0);
+			if (!top || c == foc)
+				top = c;
+		}
+		i++;
+	}
+	if (n > m->nmaster)
+		snprintf(m->ltsymbol, LENGTH(m->ltsymbol), "[D%d]", n - m->nmaster);
+	if (top)
+		wlr_scene_node_raise_to_top(&top->scene->node);
+}
+

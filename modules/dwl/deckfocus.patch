+void
+focusmaster(const Arg *arg)
+{
+	/* From the stack (or a floating window), focus the first master; from
+	 * the master area, go back to the stack card last focused. */
+	Client *sel, *t = NULL;
+	int pos, n;
+
+	if (!selmon)
+		return;
+	sel = focustop(selmon);
+	pos = sel ? tiledpos(selmon, sel, &n) : (tiledpos(selmon, NULL, &n), -1);
+	if (n == 0)
+		return;
+	if (pos >= 0 && pos < selmon->nmaster) {
+		if (n > selmon->nmaster && !(t = deckcardfor(selmon)))
+			t = tiledat(selmon, selmon->nmaster);
+	} else {
+		t = tiledat(selmon, 0);
+	}
+	if (t)
+		focusclient(t, 1);
+}

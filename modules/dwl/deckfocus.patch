+/* Index of t among m's tiled clients in tiling order (-1 if it is not
+ * one); *total gets the number of tiled clients. */
+int
+tiledpos(Monitor *m, Client *t, int *total)
+{
+	Client *c;
+	int i = 0, pos = -1;
+
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+			continue;
+		if (c == t)
+			pos = i;
+		i++;
+	}
+	*total = i;
+	return pos;
+}
+
+Client *
+tiledat(Monitor *m, int idx)
+{
+	Client *c;
+	int i = 0;
+
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+			continue;
+		if (i++ == idx)
+			return c;
+	}
+	return NULL;
+}
+
+/* The stack card focused last, if it is still a stack card on m */
+static Client *deckcard;
+
+Client *
+deckcardfor(Monitor *m)
+{
+	int n;
+
+	if (deckcard && tiledpos(m, deckcard, &n) >= m->nmaster)
+		return deckcard;
+	return NULL;
+}
+
+void
+deckfocused(Client *c)
+{
+	Monitor *m = c->mon;
+	int n;
+
+	if (!m || m->lt[m->sellt]->arrange != deck)
+		return;
+	if (tiledpos(m, c, &n) >= m->nmaster) {
+		deckcard = c;
+		decksymbol(m, c);
+	}
+}
+
+/* Layout symbol "[D pos/count]": position of the shown card in the stack */
+void
+decksymbol(Monitor *m, Client *top)
+{
+	int n, pos;
+
+	if (!top || (pos = tiledpos(m, top, &n)) < m->nmaster || n <= m->nmaster)
+		return;
+	snprintf(m->ltsymbol, LENGTH(m->ltsymbol), "[D %d/%d]",
+			pos - m->nmaster + 1, n - m->nmaster);
+}
